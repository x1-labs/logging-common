{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "reviewers": ["copilot-pull-request-reviewer[bot]"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "major": {
    "dependencyDashboardApproval": true
  },
  "enabledManagers": ["bun", "github-actions"],
  "bun": {
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["before 9am on the first day of the month"]
    }
  },
  "packageRules": [
    {
      "description": "A published library: bump only dev dependencies, so consumers keep their version floors. Lockfile maintenance refreshes the rest. Renovate cannot read locked versions from bun.lock (renovatebot/renovate#47856).",
      "matchManagers": ["bun"],
      "rangeStrategy": "bump",
      "matchDepTypes": ["devDependencies"]
    },
    {
      "description": "Non-major JavaScript updates in one PR.",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "javascript dependencies"
    },
    {
      "description": "GitHub Actions: all non-major pin updates in one PR.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions"
    },
    {
      "description": "The Bun version in the Dockerfile, in CI and in bun-types moves in one PR.",
      "matchDepNames": ["oven/bun", "bun", "bun-types", "@types/bun"],
      "groupName": "bun"
    }
  ],
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump"
  }
}
